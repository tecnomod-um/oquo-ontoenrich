<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/oquo-ontoenrich#"
     xml:base="https://purl.org/oquo-ontoenrich"
     xmlns:oquo="https://purl.org/oquo#"
     xmlns:oquo-oquare-qm="https://purl.org/oquo-oquare-qm#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:om-1="http://www.wurvoc.org/vocabularies/om-1.8/"
     xmlns:rdf1="http://www.cropontology.org/rdf/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:QualityModel="http://purl.org/net/QualityModel#">
    <owl:Ontology rdf:about="https://purl.org/oquo-ontoenrich">
        <owl:versionIRI rdf:resource="https://purl.org/oquo-ontoenrich/v2.0.0"/>
        <owl:imports rdf:resource="https://purl.org/oquo-oquare-qm/v2.0.0"/>
        <dc:title xml:lang="en">OQUO OntoEnrich module</dc:title>
        <dc:description xml:lang="en">OQUO module that integrates OntoEnrich, a framework for the analysis of the lexical regularities of ontologies, i.e. groups of tokens that are exhibited by the labels of more than one class. The module defines the lexical regularity class and the property that links a lexical regularity with the classes that exhibit it, together with three metrics computed for each lexical regularity, namely CPE (percentage of tokens that are classes in other ontologies), locality (how close in the hierarchy are the classes that exhibit the regularity) and modularity (how the classes that exhibit the regularity descend from a set of classes of interest), and the raw scale of each metric.</dc:description>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-16</terms:created>
        <terms:license rdf:resource="http://www.apache.org/licenses/LICENSE-2.0"/>
        <dc:creator>Manuel Quesada-Martinez</dc:creator>
        <dc:contributor>Manuel Quesada-Martinez</dc:contributor>
        <dc:contributor>Francisco Abad-Navarro</dc:contributor>
        <dc:publisher>Universidad de Murcia</dc:publisher>
        <vann:preferredNamespacePrefix>oquo-ontoenrich</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://purl.org/oquo-ontoenrich#</vann:preferredNamespaceUri>
        <rdfs:seeAlso rdf:resource="https://github.com/tecnomod-um/oquo-ontoenrich"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/oquo-ontoenrich#lexicalRegularityExhibitedBy -->

    <owl:ObjectProperty rdf:about="https://purl.org/oquo-ontoenrich#lexicalRegularityExhibitedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>Link a lexical regularity with the classes that exhibit it.</rdfs:comment>
        <rdfs:label>lexicalRegularityExhibitedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/oquo-ontoenrich#LexicalRegularity -->

    <owl:Class rdf:about="https://purl.org/oquo-ontoenrich#LexicalRegularity">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/EvaluationResult#EvaluationSubject"/>
        <rdfs:comment>A group of tokens that are exhibited in more than one classes.</rdfs:comment>
        <rdfs:label>LexicalRegularity</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ontoenrich#CpeMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-ontoenrich#CpeMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ontoenrich#CpeMetricRawScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Percentage of tokens of a class that are classes in other ontologies.</obo:IAO_0000115>
        <rdf1:acronym>CPE</rdf1:acronym>
        <rdfs:label>CPE Metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ontoenrich#LocalityMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-ontoenrich#LocalityMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ontoenrich#LocalityMetricRawScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Value between 0 and 1 that measure how close are classes that exhibit a Lexical Regularity in the hierarchy.</obo:IAO_0000115>
        <rdf1:acronym>LOC</rdf1:acronym>
        <rdfs:label>Locality Metric</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/oquo-ontoenrich#ModularityMetric -->

    <owl:Class rdf:about="https://purl.org/oquo-ontoenrich#ModularityMetric">
        <rdfs:subClassOf rdf:resource="http://purl.org/net/QualityModel#DerivedMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/net/QualityModel#hasScale"/>
                <owl:hasValue rdf:resource="https://purl.org/oquo-ontoenrich#ModularityMetricRawScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Given certain set of Classes of Interest (CI), the metric calculates how the classes that exhibit a Lexical Regularity are descendant of the CIs</obo:IAO_0000115>
        <rdf1:acronym>MOD</rdf1:acronym>
        <rdfs:label>Modularity Metric</rdfs:label>
    </owl:Class>
    


